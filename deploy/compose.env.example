# Copy this file to /opt/kiwi-podcast/secrets/compose.env on the EC2 server.
# Use long random hexadecimal values so DATABASE_URL needs no URL escaping.

POSTGRES_DB=kiwi_podcast
POSTGRES_USER=kiwi_podcast
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

MINIO_ROOT_USER=kiwi_podcast
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-hex-value

# These paths are resolved relative to compose.production.yml.
# The defaults below let `docker compose config` validate this repository.
# On EC2, change them to ../secrets/api.env and ../secrets/caddy.env.
KIWI_PODCAST_API_ENV_FILE=./deploy/api.env.example
KIWI_PODCAST_CADDY_ENV_FILE=./deploy/caddy.env.example

