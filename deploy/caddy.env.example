# Copy the handed-over .env.aws values into the server-side caddy.env.
# These credentials must be limited to the kiwiai.org Route53 hosted zone.

AWS_ACCESS_KEY_ID=replace-with-the-route53-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-the-route53-secret-access-key
AWS_REGION=ap-southeast-1
AWS_HOSTED_ZONE_ID=replace-with-the-kiwiai-org-hosted-zone-id

