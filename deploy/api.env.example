# Public application and Kiwi integration
NODE_ENV=production
PORT=8010
APP_ORIGIN=https://podcast.apps.kiwiai.org,https://podcast.apps-server.kiwiai.org
KIWI_API_BASE=https://replace-with-the-production-kiwi-api.example
KIWI_APP_SLUG=podcasts
PODCAST_PUBLIC_API_BASE=https://podcast.apps.kiwiai.org

# Script generation (OpenAI-compatible provider)
LLM_BASE_URL=https://replace-with-the-llm-provider.example
LLM_API_KEY=replace-with-the-llm-api-key
LLM_MODEL=replace-with-the-llm-model
LLM_TEMPERATURE=0.7

# Text-to-speech
TTS_BASE_URL=https://litellm.tunnel.kiwiai.org
TTS_API_KEY=replace-with-the-tts-api-key
TTS_MODEL=higgs-audio-v2
TTS_TEMPERATURE=0.5
TTS_MULTI_SEED=12345
TTS_HOST_A_VOICE=nova
TTS_HOST_B_VOICE=onyx
TTS_HOST_A_SEED=505
TTS_HOST_B_SEED=404
TTS_HOST_A_DESCRIPTION=A bright female voice, warm, expressive and enthusiastic, American accent.
TTS_HOST_B_DESCRIPTION=A lively male voice, warm, engaged and upbeat, British accent.
TTS_HOST_A_REFERENCE_TEXT=Hi! I am so excited to dive into this with you today.
TTS_HOST_B_REFERENCE_TEXT=Absolutely, I have been looking forward to this all week.
TTS_SCENE_DESCRIPTION=The scene is two people having a lively, friendly podcast conversation.

# Audio production
FFMPEG_PATH=/usr/bin/ffmpeg
PODCAST_TTS_CHUNK_CHARS=600
PODCAST_CHUNK_GAP_SECONDS=0.25
PODCAST_MP3_BITRATE=192k
PODCAST_DEMO_CHUNKS_DIR=/app/apps/api/demo-chunks

# Simulator identity
PODCAST_SIMULATOR_CLASS_ID=1ef1daa0-6f00-4c52-b13f-fa85b65b3e31
PODCAST_SIMULATOR_USER_ID=sim-user-1

# Private object storage. Compose supplies endpoint and credentials.
MINIO_REGION=us-east-1
MINIO_BUCKET=kiwi-podcasts
